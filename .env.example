# Configuration du site
# Copier ce fichier en .env.local et remplir avec vos vraies valeurs

# URL du site (obligatoire pour le SEO)
# En développement local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# En production (exemples):
# NEXT_PUBLIC_SITE_URL=https://votre-site.vercel.app
# NEXT_PUBLIC_SITE_URL=https://votre-site.netlify.app
# NEXT_PUBLIC_SITE_URL=https://www.votredomaine.com

# Clé API OpenAI pour le chatbot IA
# Obtenir une clé sur https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Analytics (optionnel)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console (optionnel)
# NEXT_PUBLIC_GOOGLE_VERIFICATION=votre-code-verification
